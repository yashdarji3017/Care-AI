# ============================================================
# Application Configuration
# ============================================================
APP_NAME="PatientCare AI"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# ============================================================
# PostgreSQL Database Connection
# ============================================================
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/patientcare_db

# ============================================================
# JWT Authentication & Security
# ============================================================
JWT_SECRET_KEY=replace_with_a_strong_random_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# ============================================================
# WhatsApp Integration (Follow-Up Reminders)
# ============================================================
# Options: 'mock' (local simulator / console logger) or 'meta' (Cloud API)
WHATSAPP_PROVIDER=mock
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_whatsapp_phone_number_id_here

# ============================================================
# Storage (Prescription Uploads & Documents)
# ============================================================
UPLOAD_DIR=storage/prescriptions
MAX_UPLOAD_SIZE_MB=10

# ============================================================
# Follow-Up Reminder Background Engine
# ============================================================
REMINDER_RETRY_LIMIT=3
REMINDER_POLL_INTERVAL_SECONDS=30
